{
  "name": "derush-tool-electron",
  "version": "0.3.26",
  "description": "Electron wrapper for Derush Tool — bundles Chromium + Python backend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac --arm64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "author": "Sébastien Delahaye",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "be.sebastiendelahaye.derushtool",
    "productName": "DerushTool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "derush_icon.png",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/DerushTool",
        "to": "DerushTool"
      }
    ],
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ],
      "icon": "../derush_icon.ico",
      "artifactName": "DerushTool-${version}-win.${ext}"
    },
    "mac": {
      "target": [
        { "target": "zip", "arch": ["arm64"] },
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "icon": "../derush_icon.icns",
      "category": "public.app-category.video",
      "artifactName": "DerushTool-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "dmg": {
      "artifactName": "DerushTool-${version}-mac-${arch}.${ext}",
      "sign": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davebixby",
        "repo": "derush-tool"
      }
    ]
  }
}
