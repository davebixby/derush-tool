{
  "name": "derush-tool-electron",
  "version": "0.2.0",
  "description": "Electron wrapper for Derush Tool — bundles Chromium + Python backend",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "release": "electron-builder --win --x64 --publish always"
  },
  "author": "Sébastien Delahaye",
  "license": "Proprietary",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "build": {
    "appId": "be.sebastiendelahaye.derushtool",
    "productName": "DerushTool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/DerushTool",
        "to": "DerushTool"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "../derush_icon.ico"
    },
    "portable": {
      "artifactName": "DerushTool-Portable-${version}.${ext}",
      "unpackDirName": "DerushTool"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "davebixby",
        "repo": "derush-tool"
      }
    ]
  }
}
